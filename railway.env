# Railway Environment Variables for TaskSplitter
# Copy these variables to your Railway project settings

# ===========================================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ
# ===========================================

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Database Configuration (Railway предоставляет PostgreSQL)
# Railway автоматически установит переменную DATABASE_URL при подключении PostgreSQL
# Формат: postgres://user:password@host:port/database?sslmode=require
# 
# Если нужно использовать отдельные переменные, раскомментируйте:
# DB_HOST=your-postgres-host
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your-postgres-password
# DB_NAME=railway
# DB_SSLMODE=require

# ===========================================
# AI КОНФИГУРАЦИЯ (выберите один)
# ===========================================

# Вариант 1: GigaChat (рекомендуется)
GIGACHAT_CLIENT_ID=61e2f9ef-d364-4190-8d41-5458d59872bf
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_AUTH_KEY=NjFlMmY5ZWYtZDM2NC00MTkwLThkNDEtNTQ1OGQ1OTg3MmJmOjUxZjBiZmNiLTk4MjMtNDhiNy04ZWRmLWY5ZTY5MmJjYzAxYg==

# Вариант 2: OpenAI (если есть ключ)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-3.5-turbo

# ===========================================
# ДОПОЛНИТЕЛЬНЫЕ СЕРВИСЫ (опционально)
# ===========================================

# Redis Configuration (если подключаете Redis)
# REDIS_HOST=your-redis-host
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# REDIS_DB=0

# RabbitMQ Configuration (если подключаете RabbitMQ)
# RABBITMQ_HOST=your-rabbitmq-host
# RABBITMQ_PORT=5672
# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest
# RABBITMQ_VHOST=/

# ===========================================
# KEYCLOAK (для продакшена)
# ===========================================

# KEYCLOAK_URL=https://your-keycloak-instance.com
# KEYCLOAK_REALM=tasksplitter
# KEYCLOAK_CLIENT_ID=tasksplitter-api
# KEYCLOAK_CLIENT_SECRET=your-client-secret
# KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_ADMIN_PASS=admin

# ===========================================
# FRONTEND КОНФИГУРАЦИЯ
# ===========================================

# URL вашего Railway API (замените на ваш домен)
REACT_APP_API_URL=https://your-app-name.railway.app/api/v1
