# Environment variables for TaskSplitter
# Copy this file to .env and update values as needed

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tasksplitter
DB_SSLMODE=disable

# Или используй DATABASE_URL (приоритетнее чем отдельные переменные)
# DATABASE_URL=postgres://user:password@host:port/database?sslmode=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Или используй RABBITMQ_URL
# RABBITMQ_URL=amqp://user:password@host:port/

# Keycloak Configuration (опционально)
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=tasksplitter
KEYCLOAK_CLIENT_ID=tasksplitter-api
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASS=admin

# OpenAI Configuration (для разбивки задач)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# GigaChat Configuration (российская альтернатива)
GIGACHAT_CLIENT_ID=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_AUTH_KEY=

